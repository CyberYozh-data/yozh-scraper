############################################
# Service-to-service auth
############################################

# Shared secret guarding the internal surfaces: GET /api/v1/proxies/resolve
# (hands out reusable proxy credentials), the whole /api/v1/sessions router
# (anyone who can list session ids can hijack an authenticated browser), and
# the whole /api/v2/prem-proxies catalog (paid-account metadata, and an
# uncapped relay to the vendor on this account's API key), and
# GET /api/v1/proxies/available (HIGH-03 — it enumerates the PURCHASED
# proxies on the account: ids, hosts, ports, access type).
# Same-trust-domain callers (the crawler's /map, yozh-law-checker) send it as
# the X-Service-Token header; set the SAME value in their env. Generate one
# with e.g. `openssl rand -hex 32`. All FOUR surfaces are fail-closed:
# leaving this empty makes them refuse to serve (503) rather than degrade to
# open access — and for prem-proxies that 503 silently strips country geo from
# every yozh scan, so an empty value here is not a safe default.
SERVICE_TOKEN=

# Log line shape: text (default) or json. TEXT deliberately — the containers
# use the json-file driver with no shipper, so nothing here can query JSON
# today and the only reader is a human at `docker logs`. Correlation
# (job_id/request_id) and event names are emitted in BOTH shapes, so there is
# nothing to gain by flipping this before a log shipper exists.
LOG_FORMAT=text

# Comma-separated hosts browser navigation may reach even though they are not
# public addresses (e.g. 127.0.0.1 for the loopback e2e tests). Empty by
# default. Exact match only: no wildcard, and deliberately no global
# off-switch. Matching is on the HOST alone, so an entry opens every port on
# that host — name the narrowest host you actually need.
# Route direct-path browser traffic through a local proxy that refuses
# non-public targets, so a blocked request is never MADE rather than having its
# content withheld. ON by default — without it a redirect into the internal
# network still fires one GET and the favicon request is unguarded entirely.
# It does cost HTTP/3 and ~10x the connections on plain HTTP, both only on the
# direct path. Set false to fall back to the other egress layers, which apply
# either way.
EGRESS_TRANSPORT_GUARD=true

EGRESS_ALLOW_HOSTS=


############################################
# CyberYozh API
############################################

# API key from https://app.cyberyozh.com/api-access/
CYBERYOZH_API_KEY=

# Base URL for CyberYozh API
CYBERYOZH_BASE_URL=https://app.cyberyozh.com


############################################
# Service
############################################

# FastAPI / Uvicorn
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO


############################################
# Playwright / Browser
############################################

# DEFAULT browser launch mode; a request's `headless` field overrides it per
# scrape. Headful drops the `--headless` tell some anti-bots flag, at ~+9%
# browser RAM, and runs under a virtual X display (Xvfb, started by the
# entrypoint regardless of this setting so per-request headful always works).
# A request asking for the non-default mode launches a throwaway browser
# (~1-2s extra, no idle RAM) rather than keeping a second one warm.
HEADLESS=true

# X display number the entrypoint runs Xvfb on. Read by the entrypoint shell,
# not by the app, and exported as DISPLAY once that display is serving. The
# default is fine unless something else in the container already serves this
# number — Xvfb is started with -nolock, so it will not arbitrate for it.
XVFB_DISPLAY=99

# Chromium engine channel. Empty = Playwright's bundled Chromium. Set to "chrome"
# to drive a real Google Chrome installed in the image (better anti-bot: real
# branding/codecs + a populated navigator.plugins, newer engine). Requires
# `playwright install chrome` in the Dockerfile (already added). The UA version
# auto-tracks whatever engine launches.
CHROME_CHANNEL=

# Block images, fonts, media (faster + cheaper traffic)
BLOCK_ASSETS=true

# Default navigation timeout (ms). Spent PER PHASE, not per attempt: the
# warmup navigation, the real goto and wait_for_selector each get it in full,
# so a request using all three costs three times this. It is also a ceiling,
# not a promise — an attempt is shortened when PAGE_TASK_TIMEOUT_S cannot fit
# it, and the shortening is reported in the response warnings.
REQUEST_TIMEOUT_MS=30000

# Max attempts per scrape request when a failure looks like a proxy issue
# (used only when a proxy is selected; direct connections never retry).
MAX_RETRIES=3

# Prevent WebRTC from leaking the real IP around the proxy. Set to false
# only if you need working WebRTC (video chat / RTCPeerConnection) inside
# scraped pages.
# Camoufox: align locale/timezone to the exit IP, and spoof the WebRTC exit
# IP from it. Cached per worker process under the proxy URL (238ms cold,
# 65ms warm), so it is a one-off rather than a per-request cost — except
# against an unreachable proxy, which raises instead of caching. Turning it
# off gives up the WebRTC spoof too, not just the lookup.
CAMOUFOX_GEOIP=true

# Launch Camoufox WITHOUT uBlock Origin. Off by default: uBO is part of what
# makes Camoufox look like a real user's browser, so dropping it is a
# fingerprint cost to pay deliberately, not by default. It exists because uBO is
# NOT inert on the pages we scrape — camoufox loads it on every launch and its
# default filters REWRITE them. Measured 2026-09-04: uBO's Privacy list rewrote
# all ten organic Bing anchors from the `ck/a?...u=a1<base64>` wrapper to the
# decoded destination, which broke `bing_search_camoufox` (0 of 10 titles) until
# the preset learned to read both shapes. Note uBO is downloaded at first
# browser LAUNCH, not at image build, so its filter lists can change under a
# container recreate with nothing in the repo recording it — this switch is the
# only lever if that happens again.
CAMOUFOX_DISABLE_UBO=false

# What `fingerprint_profile=auto` resolves to for Camoufox — i.e. what a request
# that sets nothing gets. Camoufox otherwise picks its OS uniformly from
# windows/macos/linux per launch and draws the GPU and thread count from its own
# corpus, so most runs claim a machine this server is not.
#   windows_on_host  Windows, on this host's GPU vendor (default)
#   host             this host's own OS, claimed honestly
#   random           Camoufox's uniform draw, nothing pinned (pre-profile behaviour)
#   windows|macos|linux   state the OS only, hardware left to Camoufox
CAMOUFOX_FINGERPRINT_PROFILE=windows_on_host

# Override GPU-vendor detection for the profiles above AND for the GPU Chromium
# claims in its stealth WebGL override: amd/intel/nvidia/apple. Needed on a
# discrete GPU, because detection reads the CPU vendor (the container cannot see
# the GPU itself). Chromium has Chrome-shaped strings for amd and intel only —
# nvidia/apple fall back to intel there (with a warning) while Camoufox claims
# them, so the two engines then describe different GPUs.
# HOST_GPU_VENDOR=

WEBRTC_BLOCK=true

# Give Chromium a software WebGL context (--enable-unsafe-swiftshader). Without
# it a headful Chrome >= 136 on this GPU-less host hands every page a NULL
# context, which is a bot signal in itself. Costs sandbox-free JIT of shaders
# from the scraped page; set false to trade the fingerprint back for isolation.
SOFTWARE_WEBGL=true

# ISO-3166 alpha-2 country pinned for residential rotating proxies
# (res_rotating / prem_res_rotating) when a request supplies no
# proxy_geo.country_code. Without it the exit lands in a random country while
# the browser timezone/locale stay this country's defaults — a fingerprint
# mismatch. GB maps to Europe/London + en-GB, so the exit and the browser
# timezone/locale stay aligned. GB is the default rather than US because several
# targets throttle or block the US residential exit range. An explicit
# proxy_geo.country_code always wins.
DEFAULT_PROXY_COUNTRY=GB

# Dwell time (ms) between warmup page-loads before the real scrape, used by
# the prem_res_rotating warm-up path. Increase if the target enforces a
# longer cold-session gate.
WARMUP_DWELL_MS=2500



############################################
# Queue (taskiq + Redis)
############################################

# Redis connection URL — broker, job store and session store all use it.
# Default targets the compose `redis` service; override for an external Redis.
REDIS_URL=redis://redis:6379/0

# taskiq worker processes per scraper-worker container (the `--workers` flag).
# Also reported by /health. Scale total capacity with
# `docker compose up -d --scale scraper-worker=N` × WORKERS.
WORKERS=2

# Submit backpressure: reject new jobs (503) once the Redis stream depth
# exceeds this. 0 disables the check.
QUEUE_MAXSIZE=200

# Hard ceiling for one scrape_page task (all retry attempts included). Even a
# hung Playwright produces an error slot within this bound. (Replaces the old
# JOB_TIMEOUT_MS.) The retry loop sizes its attempts against this, so setting
# it below REQUEST_TIMEOUT_MS x phases silently shortens every attempt and,
# low enough, spends the rotation budget the block heuristics rely on.
PAGE_TASK_TIMEOUT_S=120

# Hard ceiling for the worker's login task (the actual login work).
LOGIN_TASK_TIMEOUT_S=45

# Extra time the login endpoint waits for the result beyond LOGIN_TASK_TIMEOUT_S.
# The worker's timeout runs from task pickup, the API's from enqueue; this grace
# absorbs queue-pickup skew so a slow-but-successful login isn't 504'd (which
# would mark the session failed and drop its storage_state).
LOGIN_RESULT_GRACE_S=15

# Pending stream entries idle longer than this are reclaimed and re-enqueued
# (worker died mid-task). Keep ~2x PAGE_TASK_TIMEOUT_S.
RECLAIM_IDLE_S=240

# Seconds a finished job's keys (status + results) live in Redis after
# finalization, via a native key TTL. Keep comfortably above how long a
# consumer takes to fetch /results. 0 disables the TTL.
JOB_RESULT_TTL_S=600

# Browser retirement: a worker recycles its browser after this many pages to
# bound Chromium memory bloat. 0 disables.
BROWSER_MAX_PAGES=100

# Seconds of inactivity after which a worker closes its Chromium to free
# memory. Next job re-launches lazily (+1-2s cold start). Set to 0 to keep
# browsers warm forever (~400-500 MB RSS per worker held permanently).
BROWSER_IDLE_SHUTDOWN_S=600

# Removed after the taskiq migration (ignored, warned at startup if set):
#   JOB_TIMEOUT_MS   → use PAGE_TASK_TIMEOUT_S
#   JOB_RESULT_MAX   → eviction is now a native Redis TTL (JOB_RESULT_TTL_S)
#   JOBS_ENABLED     → the queue is always on


############################################
# LLM (presets: self-heal, AI extraction, preset generation)
############################################

# Server-side provider keys (like CYBERYOZH_API_KEY — callers never send
# their own). Set the one(s) matching the models you intend to use; litellm
# resolves the provider from the model prefix (openai/*, anthropic/*, ...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenAI-compatible custom endpoint (e.g. ScriptRun.AI). When set,
# models prefixed `custom/` route here with CUSTOM_LLM_API_KEY.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Default model when a request doesn't specify one. Overridable per-request.
DEFAULT_LLM_MODEL=openai/gpt-5.4-mini

# Token ceiling for a single self-heal / extraction LLM call
PRESET_LLM_MAX_TOKENS=4000


############################################
# Sessions (Phase 1)
############################################

# Maximum concurrent sessions per process; LRU-evicted on overflow.
# SESSIONS_MAX=256

# Per-session storage_state byte cap; writes over this are rejected.
# SESSION_STORAGE_STATE_MAX_BYTES=2097152
